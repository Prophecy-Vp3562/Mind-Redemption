# ==============================================================================
# Mind Redemption — Production .gitignore
# Guarantee zero leakage of user data, vault partitions, credentials & caches.
# ==============================================================================

# User Data & Storage (Defensive layer)
*.json
!package.json
!tsconfig.json
data/
storage/
timeline/
timeline-admin/
*.db
*.sqlite
*.sqlite3

# Mind Redemption Specific Data Stores
mind-redemption-data.json
mind-redemption-admin-data.json
thought-redemption-data.json
thought-redemption-admin-data.json
Mind Redemption Data/
Thought Redemption Data/

# Environment & Secrets
.env
.env.local
*.env
*.key
*.pem
secrets/

# Python Artifacts & Caches
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
build/
dist/
*.egg-info/

# Local Logs & Diagnostic Outputs
*.log
err.txt
out.txt

# OS & Editor Metadata
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
